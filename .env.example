# Copier ce fichier en .env puis adapter les valeurs : cp .env.example .env

# Version de l'image n8n (mettre une version précise en production, ex: 1.x.y)
N8N_VERSION=latest

# Clé de chiffrement des credentials : NE JAMAIS la perdre ni la changer après le 1er démarrage.
# Générer avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-moi

# URL publique de n8n (utilisée pour les webhooks)
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

GENERIC_TIMEZONE=Europe/Paris

# Base de données Postgres
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-moi-aussi
POSTGRES_DB=n8n
