      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        640,
        1200
      ],
      "parameters": {
        "toolDescription": "Sous-agent qui retrouve le statut et le suivi d'UNE commande. Donne-lui le numéro de commande et l'adresse e-mail de la cliente.",
        "text": "={{ $fromAI('demande', \"Num\\u00e9ro de commande et adresse e-mail fournis par la cliente\", 'string') }}",
        "options": {
          "systemMessage": "Tu retrouves le statut d'une commande Naylia pour le service client.\n1. Utilise l'outil « Chercher la commande » avec le numéro de commande et l'adresse e-mail fournis.\n2. Si l'outil ne renvoie aucune commande, réponds « Commande introuvable avec ces informations » sans rien dévoiler d'autre.\n3. Si elle existe : donne la date, le statut de paiement, le statut d'expédition, le numéro et le lien de suivi s'il y en a, et les articles.\nNe communique jamais d'adresse postale, de téléphone ni d'informations sur d'autres commandes. Écris en français, en texte simple avec des emojis si utile, sans Markdown (pas d'astérisques ni de titres #). Sois bref et concret.",
          "maxIterations": 10
        }
      }
    },
    {
      "id": "a9b30d2e-81ad-59f3-aac2-ac2718cdea2a",
      "name": "Mémoire Suivi de commande",
