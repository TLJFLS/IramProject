    {
      "id": "57f89bcb-8bc7-55f4-9af7-f25c9a2ec645",
      "name": "Orchestrateur",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        680,
