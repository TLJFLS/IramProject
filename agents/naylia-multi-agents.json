    {
      "id": "02d1ad43-46c7-55eb-9a1e-944bd9401c62",
      "name": "Chercher la commande",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.5,
      "position": [
        720,
        1460
      ],
      "parameters": {
        "toolDescription": "Cherche une commande à partir de son numéro ET de l'adresse e-mail de la cliente. Ne renvoie rien si les deux ne correspondent pas.",
        "method": "POST",
        "url": "https://ac3ttu-kg.myshopify.com/admin/api/2026-07/graphql.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyAccessTokenApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: \"query($q: String!) { orders(first: 1, query: $q) { nodes { name createdAt cancelledAt displayFinancialStatus displayFulfillmentStatus totalPriceSet { shopMoney { amount currencyCode } } lineItems(first: 20) { nodes { title quantity } } fulfillments { status trackingInfo { number url company } } } } }\", variables: { q: 'name:#' + String($fromAI('numero_commande', 'Numéro de commande, ex. 1052', 'string')).replace(/[^0-9]/g, '') + ' AND email:' + String($fromAI('email', 'Adresse e-mail de la commande', 'string')).toLowerCase().replace(/[^a-z0-9@._+-]/g, '') } }) }}",
        "options": {}
      }
    },
