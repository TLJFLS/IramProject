{
  "id": "exempleContact01",
  "name": "Exemple - Formulaire de contact",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "a1b2c3d4-0001-4000-8000-0000000000aa",
      "parameters": {
        "httpMethod": "POST",
        "path": "contact",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Email présent ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Mettre en forme",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, -100],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "nom", "value": "={{ $json.body.nom || 'Anonyme' }}", "type": "string" },
            { "id": "s2", "name": "email", "value": "={{ $json.body.email.trim().toLowerCase() }}", "type": "string" },
            { "id": "s3", "name": "message", "value": "={{ $json.body.message || '' }}", "type": "string" },
            { "id": "s4", "name": "recuLe", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Répondre OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, -100],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"contact\": $json } }}",
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Répondre erreur",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 100],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"erreur\": \"Le champ email est obligatoire\" } }}",
        "options": { "responseCode": 400 }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Email présent ?", "type": "main", "index": 0 }]] },
    "Email présent ?": {
      "main": [
        [{ "node": "Mettre en forme", "type": "main", "index": 0 }],
        [{ "node": "Répondre erreur", "type": "main", "index": 0 }]
      ]
    },
    "Mettre en forme": { "main": [[{ "node": "Répondre OK", "type": "main", "index": 0 }]] }
  },
  "pinData": {}
}
